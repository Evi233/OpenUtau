<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:OpenUtau.App.Controls"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="64"
             x:Class="OpenUtau.App.Controls.TrackHeader" Width="300" Height="64" TrackNo="{Binding TrackNo}"
             x:DataType="vm:TrackHeaderViewModel">
  <Design.DataContext>
    <vm:TrackHeaderViewModel/>
  </Design.DataContext>
  <UserControl.Styles>
    <Style Selector="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton:checked Path">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush1}"/>
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush1Semi}"/>
    </Style>
    <Style Selector="Button.fxButton Path">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>
    <Style Selector="Button.fxButton.fxOn Path">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush1}"/>
    </Style>
    <Style Selector="Button.fxButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}" />
      </Style>
    </Style>
    <Style Selector="Button.fxButton.fxOn">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush1Semi}" />
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}" />
      </Style>
    </Style>
    <!-- The volume and pan knobs. Only app-level brushes here: the Knob palette in
         MixFxDialog.axaml is defined inside that dialog's own Border. -->
    <Style Selector="c|Knob.track">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="CapBrush" Value="{DynamicResource NeutralAccentBrush}"/>
      <Setter Property="PointerBrush" Value="{DynamicResource AccentBrush1}"/>
      <Setter Property="TickBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
      <Setter Property="TickActiveBrush" Value="{DynamicResource AccentBrush1}"/>
    </Style>
    <Style Selector="FlyoutPresenter">
      <Setter Property="Padding" Value="5"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="FlyoutPresenter.singerFlyout">
      <Setter Property="MaxWidth" Value="10000"/>
      <Setter Property="MaxHeight" Value="10000"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutPresenterBorderBrush}"/>
    </Style>
  </UserControl.Styles>
  <Border Margin="1,1,1,1" BorderThickness="1" BorderBrush="{Binding HeaderBorderBrush}"
           CornerRadius="2" PointerPressed="HeaderPointerPressed">
    <Grid ColumnDefinitions="26,*,Auto" Background="Transparent">
      <!-- Left strip: the track number and the drag handle. The whole strip reorders the
           track (same handlers as before), so the icon itself stays out of hit testing and
           the press still bubbles up to the border to select the track. -->
      <Panel Grid.Column="0" VerticalAlignment="Stretch" Background="{Binding StripBrush}"
             PointerWheelChanged="MoveHandleScrolled"
             PointerMoved="MoveHandleMoved" PointerPressed="MoveHandlePressed" PointerReleased="MoveHandleReleased">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0" Spacing="4">
          <Border Background="{DynamicResource AccentBrush1}" Height="16" Width="22" CornerRadius="1,0,2,0"
                  IsHitTestVisible="False">
            <TextBlock TextAlignment="Center" FontWeight="Bold"
                       Text="{Binding TrackNo}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <Path Width="14" Height="15" Stretch="None" IsHitTestVisible="False"
                Stroke="{Binding StripIconBrush}" StrokeThickness="1.6" StrokeLineCap="Round"
                ToolTip.Tip="{DynamicResource tracks.reorder}"
                Data="M0.5,3 H13.5 M0.5,7.5 H13.5 M0.5,12 H13.5"/>
        </StackPanel>
      </Panel>
      <!-- Name and voicebank. The voicebank line folds away on short tracks. -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center" Margin="3,0,0,0">
        <Button Name="TrackNameButton" Grid.Row="0" Classes="clear" Height="18" Margin="0" Padding="2,0,0,0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                FontSize="13" FontWeight="SemiBold" Focusable="False"
                Content="{Binding TrackName}" Click="TrackNameButtonClicked" ToolTip.Tip="{Binding TrackName}"/>
        <Button Name="SingerButton" Grid.Row="1" Classes="clear" Height="16" Margin="0" Padding="2,0,0,0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                Focusable="False" IsVisible="{Binding IsSingerVisible}"
                Click="SingerButtonClicked" ContextRequested="SingerButtonContextRequested" ToolTip.Tip="{Binding Singer}">
          <TextBlock Text="{Binding SingerDisplay}" FontSize="11" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Button>
      </Grid>
      <!-- Mix controls: volume and pan knobs, then mute, solo and fx. -->
      <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" Margin="0,2,2,2">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <c:Knob Classes="track" Minimum="-24" Maximum="12" DefaultValue="0" Value="{Binding Volume}"
                  IsEnabled="{Binding !Muted}" ToolTip.Tip="{Binding VolumeTip}"/>
          <c:Knob Classes="track" Minimum="-100" Maximum="100" DefaultValue="0" Value="{Binding Pan}"
                  IsEnabled="{Binding !Muted}" ToolTip.Tip="{Binding PanTip}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="3,0,0,0">
          <ToggleButton Classes="toolbar" Margin="0" Padding="0" Width="18" Height="18"
                        ToolTip.Tip="{DynamicResource tracks.mute}"
                        IsChecked="{Binding Mute, Mode=OneWay}" Command="{Binding ToggleMute}">
            <Path Classes="filled" Width="18" Height="18"
                  Data="M6.87 13.92H5.52v-9.83h1.74l1.28 4.01.43 1.53h.06l.44-1.53 1.27-4.01h1.74v9.83H11.1v-4.43q0-.38.03-.88.03-.5.07-1.04.04-.54.07-1.02.04-.48.07-.83H11.3l-.62 2.12-1.24 3.47H8.51L7.28 7.84 6.68 5.73H6.63q.05.34.09.82.04.48.07 1.02.03.54.06 1.04.03.5.03.88v4.43z"/>
            <ToggleButton.ContextMenu>
              <ContextMenu>
                <MenuItem Classes="context" Header="{StaticResource tracks.mute}" Command="{Binding ToggleMute}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.mute.only}" Command="{Binding MuteOnly}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.mute.allothers}" Command="{Binding MuteAllOthers}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.mute.unmuteall}" Command="{Binding UnmuteAll}"/>
              </ContextMenu>
            </ToggleButton.ContextMenu>
          </ToggleButton>
          <ToggleButton Classes="toolbar" Margin="0" Padding="0" Width="18" Height="18"
                        ToolTip.Tip="{DynamicResource tracks.solo}"
                        IsChecked="{Binding Solo, Mode=OneWay}" Command="{Binding ToggleSolo}">
            <Path Classes="filled" Width="18" Height="18"
                  Data="M5.41 12.64l.87-1.02q.57.52 1.29.85.72.32 1.53.32.93 0 1.44-.39.51-.39.51-.99 0-.48-.22-.76-.23-.29-.61-.49-.39-.19-.88-.38l-1.38-.62q-.49-.2-.98-.52-.49-.32-.8-.82-.32-.51-.32-1.22 0-.77.42-1.38.42-.61 1.17-.96.75-.35 1.73-.35.91 0 1.7.34.8.34 1.37.89l-.78.96q-.48-.42-1.04-.65-.56-.24-1.33-.24-.77 0-1.25.35-.47.35-.47.95 0 .43.24.7.25.27.65.45.39.18.81.36l1.34.59q.61.23 1.1.57.49.34.77.84.29.49.29 1.21 0 .8-.43 1.45-.42.65-1.23 1.03-.8.39-1.91.39-1.05 0-1.98-.4z"/>
            <ToggleButton.ContextMenu>
              <ContextMenu>
                <MenuItem Classes="context" Header="{StaticResource tracks.solo.only}" Command="{Binding ToggleSolo}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.solo.add}" Command="{Binding SoloAdditionally}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.solo.unsoloall}" Command="{Binding UnsoloAll}"/>
              </ContextMenu>
            </ToggleButton.ContextMenu>
          </ToggleButton>
          <Button Classes="toolbar fxButton" Margin="0" Width="18" Height="18" IsVisible="{Binding IsFxVisible}"
                  ToolTip.Tip="{DynamicResource tracks.mixfx}"
                  Classes.fxOn="{Binding MixFxEnabled}"
                  Command="{Binding OpenMixFxDialog}">
            <Path Height="18" Width="18"
                  Data="M6.76 4.72c-.63 0-1.13.11-1.52.32-.39.22-.68.51-.87.89-.18.37-.28.78-.28 1.24v1.53 4.58h1.77V7.16c0-.36.09-.63.27-.8.19-.16.47-.25.84-.25.23 0 .45.02.66.06.2.04.4.1.59.17l.34-1.3c-.25-.08-.53-.15-.83-.22-.31-.07-.63-.1-.97-.1zm-2.67 3.98-.02-1.38-1.55.08v1.3zm1.81-1.38-.03 1.38h2.04V7.32zm3.41 0 1.93 2.86-2.06 3.1h1.85l.59-.99c.08-.17.18-.35.27-.52.1-.17.19-.34.28-.51h.05c.11.17.22.34.34.52.11.17.23.34.34.51l.68.99h1.9l-2.06-2.9 1.94-3.06h-1.85l-.53.96c-.07.16-.15.33-.24.51-.09.17-.18.35-.25.51h-.05c-.09-.16-.2-.33-.31-.51-.11-.17-.21-.34-.31-.51l-.61-.96z"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid.ContextMenu>
        <ContextMenu Opening="TrackContextMenuOpening">
          <MenuItem Classes="context" Header="{DynamicResource tracks.remove}" Command="{Binding Remove}"/>
          <MenuItem Classes="context" Header="{DynamicResource tracks.moveup}" Command="{Binding MoveUp}"/>
          <MenuItem Classes="context" Header="{DynamicResource tracks.movedown}" Command="{Binding MoveDown}"/>
          <MenuItem Classes="context" Header="{DynamicResource tracks.rename}" Command="{Binding Rename}"/>
          <MenuItem Classes="context" Header="{DynamicResource tracks.trackcolor}" Command="{Binding SelectTrackColor}"/>
          <MenuItem Classes="context" Header="{DynamicResource tracks.duplicate}" Command="{Binding Duplicate}"/>
          <MenuItem Classes="context" Header="{DynamicResource tracks.duplicatesettings}" Command="{Binding DuplicateSettings}"/>
          <MenuItem Classes="context" Header="{DynamicResource dialogs.voicecolorremapping}" Command="{Binding VoiceColorRemapping}"/>
          <Separator/>
          <MenuItem Classes="context MenuItemWithSubMenu" Header="{DynamicResource tracks.selectrenderer}"
                    IsEnabled="{Binding HasSinger}" ItemsSource="{Binding RenderersMenuItems}"/>
          <MenuItem Classes="context" Header="{DynamicResource tracks.tracksettings}"
                    IsEnabled="{Binding HasSinger}" Click="TrackSettingsButtonClicked"/>
          <Separator/>
          <MenuItem Classes="context" Header="{DynamicResource tracks.mixfx}" Command="{Binding OpenMixFxDialog}"/>
        </ContextMenu>
      </Grid.ContextMenu>
    </Grid>
  </Border>
</UserControl>
