<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             x:Class="OpenUtau.App.Controls.AudioExportPanel"
             x:DataType="vm:AudioExportViewModel">
  <UserControl.Styles>
    <Style Selector="StackPanel">
      <Setter Property="Spacing" Value="4"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushSemi}"/>
      <Setter Property="MinHeight" Value="2"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="MinWidth" Value="50"/>
    </Style>
    <Style Selector="TextBlock.restart">
      <Setter Property="Text" Value="{DynamicResource prefs.note.restart}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="4,0"/>
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="{DynamicResource button.on}"/>
      <Setter Property="OffContent" Value="{DynamicResource button.off}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <!--Section heading: a rule under the title, as in the panel mockup.-->
    <Style Selector="Border.section">
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
      <Setter Property="Margin" Value="0,16,0,8"/>
      <Setter Property="Padding" Value="0,0,0,4"/>
    </Style>
    <Style Selector="Border.section > TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <StackPanel IsEnabled="{Binding !IsBusy}">
        <TextBlock Text="目标文件夹" Margin="0,6,0,0"/>
        <Grid ColumnDefinitions="*,8,32">
          <TextBox Name="ExportDestinationFolder" Text="{Binding DestinationFolder}"/>
          <Button Grid.Column="2" Height="28" MinWidth="0" Padding="6" Click="ChooseExportFolder" ToolTip.Tip="选择目标文件夹">
            <Path Width="18" Height="15" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M1 2 H7 L9 4 H19 V7 H3 L1 16 Z M4 8 H22 L19 18 H1 Z"/>
          </Button>
        </Grid>
        <TextBlock Text="文件名" Margin="0,10,0,0"/>
        <TextBox Name="ExportFileName" Text="{Binding FileName}"/>
        <Button Name="ExportAudioButton" Content="导出到文件" Height="30" HorizontalAlignment="Stretch" Margin="0,12,0,4" Click="ExportAudioClick"/>
        <Border Classes="section"><TextBlock Text="音轨"/></Border>
        <Grid ColumnDefinitions="24,*,60">
          <CheckBox Name="ExportMixDown" IsChecked="{Binding MixDown}"/>
          <TextBlock Grid.Column="1" Text="混音"/>
          <TextBlock Grid.Column="2" Text="{Binding MixProgress, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right"/>
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MixProgress}" Height="2" Foreground="{DynamicResource AccentBrush1}"/>
        <ItemsControl ItemsSource="{Binding Tracks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AudioExportTrackViewModel">
              <StackPanel Margin="0,6,0,0" IsEnabled="{Binding Enabled}">
                <Grid ColumnDefinitions="24,*,60">
                  <CheckBox IsChecked="{Binding Selected}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding Progress, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="2" Foreground="{DynamicResource AccentBrush1}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="section"><TextBlock Text="格式（WAV）"/></Border>
        <TextBlock Text="声道"/>
        <ComboBox ItemsSource="{Binding Channels}" SelectedIndex="{Binding ChannelIndex}"/>
        <TextBlock Text="气声输出" Margin="0,10,0,0"/>
        <ComboBox ItemsSource="{Binding AspirationOutputs}" SelectedIndex="{Binding AspirationIndex}"
                  ToolTip.Tip="周期／非周期分离使用 HNSEP 模型；无气声和独立气声模式需要安装 hnsep_240512 包。"/>
        <TextBlock Text="位深" Margin="0,10,0,0"/>
        <ComboBox ItemsSource="{Binding BitDepths}" SelectedIndex="{Binding BitDepthIndex}"/>
        <TextBlock Text="采样率" Margin="0,10,0,0"/>
        <ComboBox ItemsSource="{Binding SampleRates}" SelectedIndex="{Binding SampleRateIndex}"/>
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
