<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenUtau.App.Views.RecoveryDialog"
        Title="恢复文件" SystemDecorations="None" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight" MinWidth="360"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
  <StackPanel Margin="28,24" Spacing="20">
    <TextBlock Text="上次未正常退出，要恢复文件吗？" FontSize="15" TextWrapping="Wrap" MaxWidth="380"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
      <Button Name="DeclineRecoveryButton" Content="不恢复" Height="30" MinWidth="80" Click="DeclineRecoveryClick" IsCancel="True"/>
      <Button Name="RestoreRecoveryButton" Content="恢复文件" Height="30" MinWidth="90" Click="RestoreRecoveryClick" IsDefault="True"
              Foreground="{DynamicResource AccentBrush1}"/>
    </StackPanel>
  </StackPanel>
</Window>
