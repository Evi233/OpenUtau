<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        xmlns:c="clr-namespace:OpenUtau.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="650"
        x:DataType="vm:MainWindowViewModel"
        x:Class="OpenUtau.App.Views.MainWindow"
        x:CompileBindings="True"
        Icon="/Assets/open-utau.ico"
        Title="{Binding Title}" MinWidth="300" MinHeight="200" Width="{Binding Width}" Height="{Binding Height}"
        Focusable="True" KeyDown="OnKeyDown" PointerPressed="OnPointerPressed" Closing="WindowClosing"
        DragDrop.AllowDrop="True" TransparencyLevelHint="None">
  <Window.Styles>
    <Style Selector="ToggleButton.dockButton Path">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Fill" Value="{DynamicResource NeutralAccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton.dockButton:checked Path">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush1}"/>
    </Style>
    <Style Selector="ToggleButton.dockButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.dockButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.dockButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.dockButton:pointerover Path"><Setter Property="Fill" Value="{DynamicResource NeutralAccentBrush}"/></Style>
    <Style Selector="ToggleButton.dockButton:checked:pointerover Path"><Setter Property="Fill" Value="{DynamicResource AccentBrush1}"/></Style>
    <Style Selector="Button,ToggleButton">
      <Setter Property="Focusable" Value="False"/>
    </Style>
  </Window.Styles>
  <Grid>
    <Grid Name="MainGrid" Margin="{Binding $parent[Window].WindowDecorationMargin}" ColumnDefinitions="*,Auto,43">
      <Menu Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="24"
                Opened="OnMainMenuOpened" Closed="OnMainMenuClosed" PointerExited="OnMainMenuPointerLeave"
                ZIndex="1">
          <MenuItem Header="{DynamicResource menu.file}" IsEnabled="{Binding Page}">
            <MenuItem Header="{DynamicResource menu.file.new}" InputGesture="Ctrl+N" Click="OnMenuNew"/>
            <MenuItem Header="{DynamicResource menu.file.newfromtemplate}" ItemsSource="{Binding OpenTemplatesMenuItems}" Classes="MenuItemWithSubMenu"/>
            <MenuItem Header="{DynamicResource menu.file.savetemplate}" Click="OnMenuSaveTemplate"/>
            <MenuItem Header="-" Height="1"/>
            <MenuItem Header="{DynamicResource menu.file.open}" InputGesture="Ctrl+O" Click="OnMenuOpen"/>
            <MenuItem Header="{DynamicResource menu.file.openrecent}" ItemsSource="{Binding OpenRecentMenuItems}" Classes="MenuItemWithSubMenu"/>
            <MenuItem Header="{DynamicResource menu.file.openprojectlocation}" Click="OnMenuOpenProjectLocation"/>
            <MenuItem Header="-" Height="1"/>
            <MenuItem Header="{DynamicResource menu.file.save}" InputGesture="Ctrl+S" Click="OnMenuSave"/>
            <MenuItem Header="{DynamicResource menu.file.saveas}"  InputGesture="Ctrl+Shift+S" Click="OnMenuSaveAs"/>
            <MenuItem Header="-" Height="1"/>
            <MenuItem Header="{DynamicResource menu.file.importtracks}" Click="OnMenuImportTracks"/>
            <MenuItem Header="{DynamicResource menu.file.importaudio}" Click="OnMenuImportAudio"/>
            <MenuItem Header="-" Height="1"/>
            <MenuItem Header="{DynamicResource menu.file.exportaudio}" Click="OnShowAudioExportPanel"/>
            <MenuItem Header="{DynamicResource menu.file.exportproject}">
              <MenuItem Header="{DynamicResource menu.file.exportust}" Click="OnMenuExportUst"/>
              <MenuItem Header="{DynamicResource menu.file.exportustto}" Click="OnMenuExportUstTo"/>
              <MenuItem Header="{DynamicResource menu.file.exportmidi}" Click="OnMenuExportMidi"/>
              <MenuItem Header="{DynamicResource menu.file.exportds}" Click="OnMenuExportDsTo"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource menu.file.openexportlocation}" Click="OnMenuOpenProjectLocation"/>
          </MenuItem>
          <MenuItem Header="{DynamicResource menu.edit}" IsEnabled="{Binding Page}">
            <MenuItem Header="{Binding UndoText}" InputGesture="Ctrl+Z" Command="{Binding Undo}" IsEnabled="{Binding CanUndo}"/>
            <MenuItem Header="{Binding RedoText}" InputGesture="Ctrl+Y" Command="{Binding Redo}" IsEnabled="{Binding CanRedo}"/>
          </MenuItem>
          <MenuItem Header="{DynamicResource menu.project}" IsEnabled="{Binding Page}">
            <MenuItem Header="{DynamicResource menu.project.expressions}" Click="OnMenuExpressionss"/>
            <MenuItem Header="{DynamicResource menu.project.remaptimeaxis}" Click="OnMenuRemapTimeaxis"/>
          </MenuItem>
          <MenuItem Header="{DynamicResource menu.tools}">
            <MenuItem Header="{DynamicResource menu.tools.layout}">
              <MenuItem Header="{DynamicResource menu.tools.layout.reset}" Click="OnMenuLayoutReset"/>
              <MenuItem Header="{DynamicResource menu.tools.layout.vsplit11}" Click="OnMenuLayoutVSplit11"/>
              <MenuItem Header="{DynamicResource menu.tools.layout.vsplit12}" Click="OnMenuLayoutVSplit12"/>
              <MenuItem Header="{DynamicResource menu.tools.layout.vsplit13}" Click="OnMenuLayoutVSplit13"/>
              <MenuItem Header="{DynamicResource menu.tools.layout.hsplit11}" Click="OnMenuLayoutHSplit11"/>
              <MenuItem Header="{DynamicResource menu.tools.layout.hsplit12}" Click="OnMenuLayoutHSplit12"/>
              <MenuItem Header="{DynamicResource menu.tools.layout.hsplit13}" Click="OnMenuLayoutHSplit13"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource menu.tools.fullscreen}" InputGesture="F11" Click="OnMenuFullScreen"/>
            <MenuItem Header="{DynamicResource menu.tools.dawintegration}" Click="OnMenuDawIntegration"/>
            <MenuItem Header="{Binding ClearCacheHeader}" Click="OnMenuClearCache"/>
            <MenuItem Header="{DynamicResource menu.tools.debugwindow}" Click="OnMenuDebugWindow"/>
            <MenuItem Header="{DynamicResource phoneticassistant.caption}" Click="OnMenuPhoneticAssistant"/>
            <MenuItem Header="{DynamicResource menu.tools.singer.install}" Click="OnMenuInstallSinger"/>
            <MenuItem Header="{DynamicResource menu.tools.wavtoolresampler.install}" Click="OnMenuInstallWavtoolResampler"/>
            <MenuItem Header="{DynamicResource menu.tools.packages}" Click="OnMenuPackageManager"/>
          </MenuItem>
          <MenuItem Header="{DynamicResource menu.help}">
            <MenuItem Header="{DynamicResource menu.help.wiki}" Click="OnMenuWiki"/>
            <MenuItem Header="{DynamicResource menu.help.checkupdate}" Click="OnMenuCheckUpdate"/>
            <MenuItem Header="{DynamicResource menu.help.reportissue}" Click="OnMenuReportIssue"/>
            <MenuItem Header="{DynamicResource menu.help.logslocation}" Click="OnMenuLogsLocation"/>
          </MenuItem>
        </Menu>
      <Carousel SelectedIndex="{Binding Page}" >
        <!--Welcome page-->
        <Grid Margin="60,50,60,40" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,*" KeyDown="OnCarouselPageKeyDown">
          <!--Startup warnings-->
          <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <Button Click="OnWelcomeRecovery" Height="40" Content="{Binding RecoveryString}"
                    IsVisible="{Binding HasRecovery}" Background="{DynamicResource WarningBrush}">
            </Button>
          </StackPanel>
          <!--Create new project or open existing project-->
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="{DynamicResource welcome.start}" FontSize="20"/>
            <WrapPanel Margin="-4" Orientation="Horizontal">
              <Button Margin="4" Click="OnMenuNew" Height="60" Padding="12">
                <Grid ColumnDefinitions="Auto,*">
                  <Viewbox
                    Grid.RowSpan="2"
                    Width="24"
                    Height="24"
                    Margin="8,4,12,4">
                    <!--From https://github.com/microsoft/vscode-icons/blob/main/icons/light/new-file.svg-->
                    <Path Classes="clear" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M4.00024 7H3.00024V4H0.000244141V3H3.00024V0H4.00024V3H7.00024V4H4.00024V7ZM10.5002 1.09998L13.9003 4.59998L14.0002 5V13.5L13.5002 14H3.50024L3.00024 13.5V8H4.00024V13H13.0002V6H9.00024V2H5.00024V1H10.2002L10.5002 1.09998ZM10.0002 2V5H12.9003L10.0002 2Z"
                      Fill="{StaticResource NeutralAccentBrush}"/>
                  </Viewbox>

                  <StackPanel Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">

                    <TextBlock HorizontalAlignment="Stretch"
                      Text="{DynamicResource welcome.new}"
                      FontSize="14"
                      FontWeight="Normal"
                      TextWrapping="Wrap" />

                    <TextBlock HorizontalAlignment="Stretch"
                      Text="{DynamicResource welcome.new.description}"
                      FontSize="12"
                      FontWeight="Normal"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Button>

              <Button Margin="4" Click="OnMenuOpen" Height="60" Padding="12">
                <Grid ColumnDefinitions="Auto,*">
                  <Viewbox
                    Grid.RowSpan="2"
                    Width="24"
                    Height="24"
                    Margin="8,4,12,4">
                    <!--From https://github.com/microsoft/vscode-icons/blob/main/icons/dark/go-to-file.svg-->
                    <Path Classes="clear" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M6 5.9142L8.06065 3.85356L8.06065 3.14645L5.91421 1L5.2071 1.70711L5.25 1.75L5.24998 1.75002L5.49997 2H5.5L6.49999 3H3.5C2.83696 3 2.20107 3.2634 1.73223 3.73224C1.26339 4.20108 1 4.83696 1 5.5C1 6.16305 1.26339 6.79893 1.73223 7.26777C2.20107 7.73661 2.83696 8 3.5 8H4V7H3.5C3.10218 7 2.72064 6.84197 2.43934 6.56066C2.15804 6.27936 2 5.89783 2 5.5C2 5.10218 2.15804 4.72065 2.43934 4.43934C2.72064 4.15804 3.10218 4 3.5 4H5V4.00003H5.49996L5.49999 4H6.49999L5.2071 5.29289L5.20711 5.29291L5.2071 5.29292L5.91421 6.00003L6 5.91423V5.9142ZM11 2H8.32838L7.32839 1H12L12.71 1.29L15.71 4.29L16 5V14L15 15H6L5 14V9.00003V6.50003L6 7.34699V14H15V6H11V2ZM12 2V5H15L12 2Z"
                      Fill="{StaticResource NeutralAccentBrush}"/>
                  </Viewbox>

                  <StackPanel Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">

                    <TextBlock HorizontalAlignment="Stretch"
                      Text="{DynamicResource welcome.open}"
                      FontSize="14"
                      FontWeight="Normal"
                      TextWrapping="Wrap" />

                    <TextBlock HorizontalAlignment="Stretch"
                      Text="{DynamicResource welcome.open.description}"
                      FontSize="12"
                      FontWeight="Normal"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Button>
            </WrapPanel>
          </StackPanel>

          <!-- Recent files -->
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,24,0,8" Text="{DynamicResource welcome.recent}" FontSize="20"/>
          <ListBox ItemsSource="{Binding RecentFiles}" Grid.Row="3" Grid.Column="0" Margin="0,0,15,0" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Height" Value="NaN" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentFileInfo">
                <StackPanel Margin="0,4" PointerPressed="OnWelcomeRecent" Background="Transparent">
                  <TextBlock FontSize="16" Text="{Binding Name}"/>
                  <TextBlock FontSize="12" Text="{Binding Directory}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Template files -->
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="15,24,0,8" Text="{DynamicResource welcome.template}" FontSize="20"/>
          <ListBox ItemsSource="{Binding TemplateFiles}" Grid.Row="3" Grid.Column="1" Margin="15,0,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Height" Value="NaN" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentFileInfo">
                <StackPanel Margin="0,4" PointerPressed="OnWelcomeTemplate" Background="Transparent">
                  <TextBlock FontSize="16" Text="{Binding Name}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      
        <!--Main page-->
        <Grid ColumnDefinitions="300,*,24" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" KeyDown="OnCarouselPageKeyDown">
          <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*" MinHeight="0.01"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="3*"
                           MinHeight="{Binding PianoRollMinHeight}"
                           MaxHeight="{Binding PianoRollMaxHeight}"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="4"/>
          </Grid.RowDefinitions>
          <Panel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="24">
            <!-- The arrangement menu: track operations that do not belong on a single row. -->
            <Button Name="ArrangementMenuButton" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                    Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False"
                    ToolTip.Tip="{DynamicResource tracks.arrangement}">
              <Path Stroke="{Binding $parent[Window].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round"
                    Width="14" Height="14" Stretch="None"
                    Data="M0.5,2 H13.5 M0.5,7 H13.5 M0.5,12 H13.5"/>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="{DynamicResource command.track.add}" Click="OnArrangementAddTrack"/>
                  <MenuItem Header="{DynamicResource tracks.duplicate}" Click="OnArrangementDuplicateTrack"/>
                  <MenuItem Header="{DynamicResource tracks.remove}" Click="OnArrangementRemoveTrack"/>
                  <MenuItem Header="-" Height="1"/>
                  <MenuItem Header="{DynamicResource tracks.moveup}" Click="OnArrangementMoveUp"/>
                  <MenuItem Header="{DynamicResource tracks.movedown}" Click="OnArrangementMoveDown"/>
                  <MenuItem Header="-" Height="1"/>
                  <MenuItem Header="{DynamicResource tracks.trackheight}">
                    <MenuItem Header="{DynamicResource tracks.trackheight.small}" Click="OnArrangementTrackHeightSmall"/>
                    <MenuItem Header="{DynamicResource tracks.trackheight.normal}" Click="OnArrangementTrackHeightNormal"/>
                    <MenuItem Header="{DynamicResource tracks.trackheight.large}" Click="OnArrangementTrackHeightLarge"/>
                  </MenuItem>
                  <MenuItem Header="{DynamicResource tracks.showpianoroll}" ToggleType="CheckBox"
                            IsChecked="{Binding ShowPianoRoll, Mode=TwoWay}"/>
                  <MenuItem Header="{DynamicResource tracks.trackcolor}" Click="OnArrangementTrackColor"/>
                  <MenuItem Header="-" Height="1"/>
                  <MenuItem Header="{DynamicResource menu.tools.layout.reset}" Click="OnMenuLayoutReset"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Border Classes="playback" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Button Command="{Binding PlaybackViewModel.SeekStart}" Height="18">
                  <Path Fill="{Binding $parent[Window].Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="18" Width="18"
                        Data="M5.35 4.3H7.44V13.7H5.35ZM7.44 9L12.65 4.3V13.7Z"/>
                </Button>
                <Button Click="OnPlayOrPause" Height="18">
                  <Path Fill="{Binding $parent[Window].Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="18" Width="18"
                        Data="M5.35 4.3L12.65 9.01L5.35 13.7Z"/>
                </Button>
                <Button Command="{Binding PlaybackViewModel.Pause}" Height="18">
                  <Path Fill="{Binding $parent[Window].Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="18" Width="18"
                        Data="M5.35 4.3H7.78V13.7H5.35ZM10.22 4.3H12.65V13.7H10.22Z"/>
                </Button>
                <Button Command="{Binding PlaybackViewModel.SeekEnd}" Height="18">
                  <Path Fill="{Binding $parent[Window].Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="18" Width="18"
                        Data="M5.35 4.3L10.56 9L5.35 13.7ZM10.56 4.3H12.65V13.7H10.56Z"/>
                </Button>
                <ToggleButton IsChecked="{Binding PlaybackViewModel.LoopPlayback}"
                              ToolTip.Tip="{DynamicResource tip.playback.loop}" Height="18">
                  <Path Fill="{Binding $parent[Window].Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="18" Width="18"
                        Data="M5.19 4.86H11.11V2.8l2.53 3.09-2.53 3.1V6.93H6.05V8.99H4.35V6.93c0-1.14.34-2.07.84-2.07ZM12.81 13.13H6.88v2.07L4.35 12.1l2.53-3.1V11.06h5.08V8.99H13.65v2.07c0 1.14-.34 2.07-.84 2.07Z"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding PlaybackViewModel.Metronome}" Height="18"
                              ToolTip.Tip="{DynamicResource prefs.playback.metronome}">
                  <Path Fill="{Binding $parent[Window].Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="18" Width="18"
                        Data="M7.93 4.3a.43.34 0 0 0-.41.25L4.33 13.25a.43.34 0 0 0 .41.45h8.5a.43.34 0 0 0 .41-.45L12.32 9.65l-1.89 1.36c-.09.56-.7 1.02-1.42 1.02-.78 0-1.44-.54-1.44-1.18 0-.64.66-1.18 1.44-1.18.01 0 .02 0 .03 0l2.61-1.85-1.2-3.27a.43.34 0 0 0-.41-.25ZM14.65 6.13a.8.66 0 0 0-.48.16L9.13 9.92a1.17.95 0 0 0-1.17.95 1.17.95 0 0 0 1.17.95 1.17.95 0 0 0 1.16-.9l5.06-3.65a.8.66 0 0 0 .07-.92.8.66 0 0 0-.66-.22Z"/>
                </ToggleButton>
              </StackPanel>
            </Border>
            <Border Classes="playback" Width="72" HorizontalAlignment="Right" Margin="4,0">
              <Grid>
                <TextBlock Text="{Binding Path=PlaybackViewModel.PlayPosTime, StringFormat={}{0:mm\\:ss\\.fff}}"/>
              </Grid>
            </Border>
          </Panel>
          <ScrollBar Name="HScrollBar" Classes="music rangeStrip" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Margin="0,4,0,4" Orientation="Horizontal" AllowAutoHide="False"
                    DataContext="{Binding TracksViewModel}"
                    Maximum="{Binding HScrollBarMax, Mode=OneWay}"
                    Value="{Binding TickOffset}"
                    ViewportSize="{Binding ViewportTicks}"
                    LargeChange="{Binding ViewportTicks}"
                    SmallChange="{Binding SmallChangeX}" PointerWheelChanged="HScrollPointerWheelChanged"/>
          <ScrollBar Name="VScrollBar" Classes="music" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Margin="4,0,4,0" Orientation="Vertical" AllowAutoHide="False"
                    DataContext="{Binding TracksViewModel}"
                    Maximum="{Binding VScrollBarMax, Mode=OneWay}"
                    Value="{Binding TrackOffset}"
                    ViewportSize="{Binding ViewportTracks}"
                    LargeChange="{Binding ViewportTracks}"
                    SmallChange="{Binding SmallChangeY}" PointerWheelChanged="VScrollPointerWheelChanged"/>
          <Canvas Name="TimelineCanvas" Grid.Row="1" Grid.Column="1"
                  Background="Transparent" ClipToBounds="True"
                  PointerWheelChanged="TimelinePointerWheelChanged"
                  PointerPressed="TimelinePointerPressed"
                  PointerMoved="TimelinePointerMoved"
                  PointerReleased="TimelinePointerReleased"
                  DoubleTapped="TimelineDoubleTapped">
            <Canvas.ContextMenu>
              <ContextMenu Name="TimelineContextMenu" ItemsSource="{Binding TimelineContextMenuItems}">
                <ContextMenu.Styles>
                  <Style Selector="MenuItem" x:DataType="vm:MenuItemViewModel">
                    <Setter Property="Header" Value="{Binding Header}"/>
                    <Setter Property="Command" Value="{Binding Command}"/>
                    <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                    <Setter Property="ItemsSource" Value="{Binding Items}"/>
                  </Style>
                </ContextMenu.Styles>
              </ContextMenu>
            </Canvas.ContextMenu>
          </Canvas>
          <c:TrackHeaderCanvas Grid.Row="2" Grid.Column="0" ClipToBounds="True" Background="Transparent"
                              DataContext="{Binding TracksViewModel}"
                              TrackHeight="{Binding TrackHeight}"
                              TrackOffset="{Binding TrackOffset}"
                              Items="{Binding Tracks}"
                              PointerWheelChanged="MainPagePointerWheelChanged"
                              Cursor="Arrow"/>
          <c:TrackBackground Grid.Row="2" Grid.Column="1" Margin="0" IsHitTestVisible="False"
                            Foreground="{DynamicResource TrackBackgroundAltBrush}"
                            DataContext="{Binding TracksViewModel}"
                            Bounds="{Binding Bounds, Mode=OneWayToSource}"
                            TrackHeight="{Binding TrackHeight}"
                            TrackOffset="{Binding TrackOffset}"/>
          <c:TickBackground Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="0" IsHitTestVisible="False"
                            Foreground="{DynamicResource TickLineBrush}"
                            Background="{DynamicResource TickLineBrushLow}"
                            Resolution="{Binding PlaybackViewModel.Resolution}"
                            TickWidth="{Binding TracksViewModel.TickWidth}"
                            TickOffset="{Binding TracksViewModel.TickOffset}"
                            SnapDiv="{Binding TracksViewModel.SnapDiv}"
                            SnapTicks="{Binding TracksViewModel.SnapTicks}"
                            ShowBar="True"/>
          <!-- Time signature and tempo, pinned to the left end of the ruler. Its opaque background
               covers the copy TickBackground draws at tick 0, so they are not shown twice.
               Double-clicking either number opens its editor; the wheel over the tempo nudges it. -->
          <Border Classes="playback" Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                  VerticalAlignment="Center" Margin="4,0"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid>
              <TextBlock Name="TimeSignatureText" Width="28" HorizontalAlignment="Left"
                        Background="Transparent" DoubleTapped="OnEditTimeSignature">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}/{1}">
                    <Binding Path="PlaybackViewModel.BeatPerBar"/>
                    <Binding Path="PlaybackViewModel.BeatUnit"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Name="TempoText" Width="42" HorizontalAlignment="Right"
                          Background="Transparent" DoubleTapped="OnEditBpm" PointerWheelChanged="OnEditBpmScroll">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0:#0.00}">
                    <Binding Path="PlaybackViewModel.Bpm"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </Border>
          <!-- The playhead rides above the ruler, and so above the time signature and tempo that
               share its corner, which are still what takes the click here: this layer is not hit
               test visible, so pointer events fall through to the pill underneath. -->
          <Canvas Grid.Row="1" Grid.Column="1" ClipToBounds="True" IsHitTestVisible="False">
            <Path Name="PlayPos"
                  Canvas.Left="{Binding TracksViewModel.PlayPosX}"
                  Canvas.Top="0"
                  Fill="{DynamicResource NeutralAccentBrushSemi}"
                  Data="M -6.5 0 L 6.5 0 L 6.5 3 L 0 9 L -6.5 3 Z"/>
          </Canvas>
          <c:PartsCanvas x:Name="partsCanvas" Grid.Row="2" Grid.Column="1" ClipToBounds="True" Background="Transparent"
                        DataContext="{Binding TracksViewModel}"
                        TickWidth="{Binding TickWidth}"
                        TrackHeight="{Binding TrackHeight}"
                        TickOffset="{Binding TickOffset}"
                        TrackOffset="{Binding TrackOffset}"
                        PianoRollOpenPart="{Binding PianoRollOpenPart}"
                        PianoRollViewTickOffset="{Binding PianoRollViewTickOffset}"
                        PianoRollViewViewportTicks="{Binding PianoRollViewViewportTicks}"
                        Items="{Binding Parts}"
                        PointerPressed="PartsCanvasPointerPressed"
                        PointerMoved="PartsCanvasPointerMoved"
                        PointerExited="PartsCanvasPointerExited"
                        PointerReleased="PartsCanvasPointerReleased"
                        DoubleTapped="PartsCanvasDoubleTapped"
                        PointerWheelChanged="MainPagePointerWheelChanged">
            <Rectangle Name="PlayPosHighlight"
                      Width="{Binding PlayPosHighlightWidth, Mode=OneWay}"
                      Height="{Binding $parent.Bounds.Height, Mode=OneWay}"
                      Canvas.Left="{Binding PlayPosHighlightX, Mode=OneWay}"
                      Canvas.Top="0"
                      Fill="{DynamicResource NeutralAccentBrushSemi2}"
                      IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlaybackViewModel.ShowPlayPosHighlight}"
                      IsHitTestVisible="False"/>
            <Rectangle Name="PlayPosLine"
                       Canvas.Left="{Binding PlayPosX}"
                       Canvas.Top="0" Width="1"
                       Height="{Binding $parent.Bounds.Height, Mode=OneWay}"
                       ZIndex="99" IsHitTestVisible="False"
                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlaybackViewModel.IsPlaying}"
                       Fill="{DynamicResource AccentBrush2}"/>
            <Rectangle Name="SelectionBox" StrokeThickness="2"
                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                      Fill="{DynamicResource TickLineBrushLow}" ZIndex="1000"
                      IsHitTestVisible="False" IsVisible="False"/>
            <c:PartsCanvas.ContextMenu>
              <ContextMenu Name="PartsContextMenu"
                          Opening="PartsContextMenuOpening"
                          Closing="PartsContextMenuClosing"
                          x:DataType="vm:PartsContextMenuArgs">
                <MenuItem Header="{DynamicResource context.part.delete}"
                          Command="{Binding PartDeleteCommand}"
                          CommandParameter="{Binding Part}"/>
                <MenuItem Header="{DynamicResource context.part.gotofile}"
                          IsVisible="{Binding IsWavePart}"
                          Command="{Binding PartGotoFileCommand}"
                          CommandParameter="{Binding Part}"/>
                <MenuItem Header="{DynamicResource context.part.replaceaudio}"
                          IsVisible="{Binding IsWavePart}"
                          Command="{Binding PartReplaceAudioCommand}"
                          CommandParameter="{Binding Part}"/>
                <MenuItem Header="{DynamicResource context.part.transcribe}"
                          IsVisible="{Binding IsWavePart}"
                          Command="{Binding PartTranscribeCommand}"
                          CommandParameter="{Binding Part}"/>
                <MenuItem Header="{DynamicResource context.part.rename}"
                          IsVisible="{Binding IsVoicePart}"
                          Command="{Binding PartRenameCommand}"
                          CommandParameter="{Binding Part}"/>
                <MenuItem Header="{DynamicResource context.part.merge}"
                          IsVisible="{Binding IsVoicePart}"
                          Command="{Binding PartMergeCommand}"
                          CommandParameter="{Binding Part}"/>
                <MenuItem Header="{DynamicResource context.part.split}"
                          IsVisible="{Binding IsVoicePart}"
                          Command="{Binding PartSplitCommand}"
                          CommandParameter="{Binding Part}"/>
                <MenuItem Header="{DynamicResource context.part.applypitch}"
                          IsVisible="{Binding IsVoicePart}"
                          ItemsSource="{Binding PartApplyPitchMenuItems}"
                          Classes="MenuItemWithSubMenu"/>
              </ContextMenu>
            </c:PartsCanvas.ContextMenu>
          </c:PartsCanvas>
          <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                  BoxShadow="inset 0 0 5 1 #3F000000" ClipToBounds="True" IsHitTestVisible="False">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,5"
                    IsVisible="{Binding TracksViewModel.PlayPosWaitingRendering}" Background="{DynamicResource BackgroundBrushSemi}">
              <TextBlock Text="{DynamicResource progress.waitingrendering}" FontSize="15"/>
            </Border>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0" Height="24" PointerWheelChanged="ViewScalerPointerWheelChanged">
            <c:ViewScaler Name="VScaler" DataContext="{Binding TracksViewModel}" Value="{Binding TrackHeight}" Min="{Binding TrackHeightMin}" Max="{Binding TrackHeightMax}"/>
          </Border>
          <GridSplitter Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Focusable="False" Cursor="SizeNorthSouth" IsVisible="{Binding ShowPianoRoll}"/>
          <ContentControl Grid.Row="4" Grid.ColumnSpan="3" Name="PianoRollContainer"/>
          <TextBlock Grid.Row="5" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Height="20" Margin="4,4,4,0" Text="{Binding ProgressText}"/>
          <ProgressBar Grid.Row="6" Grid.ColumnSpan="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Value="{Binding Progress}"/>
        </Grid>
      </Carousel>
      <!--Settings panel, opened from the gear in the function bar. The column
          is Auto sized, so hiding the Border collapses it to nothing.-->
      <ScrollViewer Name="SidePanelsViewport" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
      <c:SlidingDock Grid.Column="0" ExpandedWidth="340" IsOpen="{Binding IsPreferencesPanelOpen}">
      <Border Width="340" HorizontalAlignment="Left"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="32" Margin="10,0">
            <Path Grid.Column="0" Height="16" Width="16" VerticalAlignment="Center"
                  Data="M9.001425 11.34a2.35 2.35 0 0 1-2.34-2.34 2.35 2.35 0 0 1 2.34-2.34 2.35 2.35 0 0 1 2.35 2.34 2.35 2.35 0 0 1-2.35 2.35m4.98-1.7a5.2 5.2 0 0 0 0-1.32l1.41-1.1c.13-.1.16-.27.08-.42l-1.34-2.32a.33.33 0 0 0-.4-.15l-1.67.67a4.86 4.86 0 0 0-1.14-.65l-.25-1.78a.34.34 0 0 0-.33-.28h-2.68c-.17 0-.3.12-.33.28l-.25 1.78c-.42.16-.79.4-1.14.65l-1.66-.67a.33.33 0 0 0-.41.15l-1.34 2.32a.33.33 0 0 0 .08.43l1.41 1.09a5.73 5.73 0 0 0 0 1.32l-1.41 1.11a.33.33 0 0 0-.08.43l1.34 2.32c.08.15.26.2.4 0.15l1.67-.68c.35.27.71.5 1.14.66l.25 1.78c.02.16.16.28.33.28h2.68c.17 0 .3-.12.33-.28l.25-1.78c.42-.17.79-.4 1.14-.66l1.66.68c.15.05.33 0 .41-.15l1.34-2.32a.34.34 0 0 0-.08-.43l-1.41-1.1z"
                  Fill="{StaticResource NeutralAccentBrush}"/>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Text="{DynamicResource menu.tools.prefs}"/>
            <Button Grid.Column="2" Classes="clear" Width="24" Height="24" Margin="0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnClosePreferencesPanel">
              <Path Height="16" Width="16"
                    Stroke="{StaticResource NeutralAccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M10 3.5 L5.5 8 L10 12.5"/>
            </Button>
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  BorderThickness="0,1,0,0">
            <!-- Through a ContentControl so the panel is only realized once the
                 view model exists: its compiled bindings would otherwise run
                 against this window's DataContext while it is being attached. -->
            <ContentControl Content="{Binding PreferencesViewModel}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:PreferencesViewModel">
                  <c:PreferencesPanel/>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </Grid>
      </Border>
      </c:SlidingDock>
      <!--Voice panel, opened from the voice button in the function bar, and
          independent of the settings panel next to it. It edits the selected
          track, so it follows the track selection rather than a global singer.-->
      <c:SlidingDock Grid.Column="1" ExpandedWidth="300" IsOpen="{Binding IsVoicePanelOpen}">
      <Border Width="300" HorizontalAlignment="Left"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="32" Margin="10,0">
            <Path Grid.Column="0" Height="16" Width="16" VerticalAlignment="Center"
                  Data="M12,4C14.5,4 16.5,6 16.5,8.5C16.5,10.11 15.66,11.53 14.4,12.33L15.5,20H8.5L9.6,12.33C8.34,11.53 7.5,10.11 7.5,8.5C7.5,6 9.5,4 12,4M12,6A2.5,2.5 0 0,0 9.5,8.5A2.5,2.5 0 0,0 12,11A2.5,2.5 0 0,0 14.5,8.5A2.5,2.5 0 0,0 12,6Z"
                  Fill="{StaticResource NeutralAccentBrush}"/>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Text="{DynamicResource tracks.voice}"/>
            <Button Grid.Column="2" Classes="clear" Width="24" Height="24" Margin="0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnCloseVoicePanel">
              <Path Height="16" Width="16"
                    Stroke="{StaticResource NeutralAccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M10 3.5 L5.5 8 L10 12.5"/>
            </Button>
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  BorderThickness="0,1,0,0">
            <!-- Through a ContentControl so the panel is only realized once the
                 view model exists: its compiled bindings would otherwise run
                 against this window's DataContext while it is being attached. -->
            <ContentControl Content="{Binding VoiceViewModel}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:TrackVoiceViewModel">
                  <c:TrackVoicePanel/>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </Grid>
      </Border>
      </c:SlidingDock>
      <!--Note properties, opened from the note properties button in the function bar. It edits
          whichever notes the piano roll has selected, so it follows the note selection rather
          than the part that happens to be open.-->
      <c:SlidingDock Grid.Column="2" ExpandedWidth="400" IsOpen="{Binding IsNotePropertiesPanelOpen}">
      <Border Width="400" HorizontalAlignment="Left"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="32" Margin="10,0">
            <Path Grid.Column="0" Height="16" Width="16" VerticalAlignment="Center"
                  Data="M9 5L21 1V16C21 18.2 19.2 20 17 20C14.8 20 14 18.7 15 17C15.7 15.7 17.5 14.8 19 15V5L11 7.7V19C11 21.2 9.2 23 7 23C4.8 23 4 21.7 5 20C5.7 18.7 7.5 17.8 9 18Z"
                  Fill="{StaticResource NeutralAccentBrush}"/>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Text="{DynamicResource noteproperty}"/>
            <Button Grid.Column="2" Classes="clear" Width="24" Height="24" Margin="0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnCloseNotePropertiesPanel">
              <Path Height="16" Width="16"
                    Stroke="{StaticResource NeutralAccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M10 3.5 L5.5 8 L10 12.5"/>
            </Button>
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  BorderThickness="0,1,0,0">
            <!-- Through a ContentControl so the panel is only realized once the
                 view model exists, and so it is seated before it is built. -->
            <ContentControl Content="{Binding NotePropertiesViewModel}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:NotePropertiesViewModel">
                  <c:NotePropertiesControl/>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </Grid>
      </Border>
      </c:SlidingDock>
      <c:SlidingDock Grid.Column="3" ExpandedWidth="340" IsOpen="{Binding IsRenderPanelOpen}">
      <Border Width="340" HorizontalAlignment="Left"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="32" Margin="10,0">
            <Path Grid.Column="0" Height="16" Width="16" VerticalAlignment="Center"
                  Data="M2,5H23V17H18V20H7V17H2V5Z M4,7V15H21V7H4Z M9,8A3,3 0 1,0 9,14A3,3 0 1,0 9,8Z M17,8A3,3 0 1,0 17,14A3,3 0 1,0 17,8Z M0,3H2V20H0V3Z"
                  Fill="{StaticResource NeutralAccentBrush}"/>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Text="{DynamicResource prefs.rendering}"/>
            <Button Grid.Column="2" Classes="clear" Width="24" Height="24" Margin="0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnCloseRenderPanel">
              <Path Height="16" Width="16"
                    Stroke="{StaticResource NeutralAccentBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M10 3.5 L5.5 8 L10 12.5"/>
            </Button>
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  BorderThickness="0,1,0,0">
            <!-- Through a ContentControl so the panel is only realized once the
                 view model exists: its compiled bindings would otherwise run
                 against this window's DataContext while it is being attached. -->
            <ContentControl Content="{Binding PreferencesViewModel}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:PreferencesViewModel">
                  <c:RenderPreferencesPanel/>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </Grid>
      </Border>
      </c:SlidingDock>
      <!--Function bar, pinned to the right edge of the window so it stays put
          no matter which page the carousel shows. More entries can be appended
          to this StackPanel as they are added.-->
      <c:SlidingDock Grid.Column="4" ExpandedWidth="340" IsOpen="{Binding IsAudioExportPanelOpen}">
      <Border Width="340" HorizontalAlignment="Left"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="32,*">
          <Grid ColumnDefinitions="*,28" Margin="10,0">
            <TextBlock Text="导出音频" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="clear" Width="24" Height="24" Padding="0" Click="OnCloseAudioExportPanel">
              <Path Width="10" Height="14" Stretch="Uniform" Stroke="{DynamicResource NeutralAccentBrush}" StrokeThickness="1.5" Data="M8 1L2 7L8 13"/>
            </Button>
          </Grid>
          <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
            <ContentControl Content="{Binding AudioExportViewModel}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:AudioExportViewModel"><c:AudioExportPanel/></DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </Grid>
      </Border>
      </c:SlidingDock>
        </Grid>
      </ScrollViewer>
      <Border Name="RightToolBar" Grid.Row="0" Grid.Column="2" Width="43"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1,0,0,0">
        <StackPanel Orientation="Vertical" Margin="0,32,0,4">
          <ToggleButton x:Name="VoiceButton" Classes="normal dockButton" Background="Transparent"
                        Width="35" Height="44" Margin="2,8" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsChecked="{Binding IsVoicePanelOpen, Mode=OneWay}"
                        Click="OnToggleVoicePanel"
                        ToolTip.Tip="{DynamicResource tracks.voice}">
            <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"/>
          </ToggleButton>
          <ToggleButton x:Name="NotePropertiesButton" Classes="normal dockButton" Background="Transparent"
                        Width="35" Height="44" Margin="2,8" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsChecked="{Binding IsNotePropertiesPanelOpen, Mode=OneWay}"
                        Click="OnToggleNotePropertiesPanel"
                        ToolTip.Tip="{DynamicResource noteproperty}">
            <Path Data="M9 5L21 1V16C21 18.2 19.2 20 17 20C14.8 20 14 18.7 15 17C15.7 15.7 17.5 14.8 19 15V5L11 7.7V19C11 21.2 9.2 23 7 23C4.8 23 4 21.7 5 20C5.7 18.7 7.5 17.8 9 18Z"/>
          </ToggleButton>
          <ToggleButton x:Name="RenderButton" Classes="normal dockButton" Background="Transparent"
                        Width="35" Height="44" Margin="2,8" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsChecked="{Binding IsRenderPanelOpen, Mode=OneWay}"
                        Click="OnToggleRenderPanel"
                        ToolTip.Tip="{DynamicResource prefs.rendering}">
            <Path Data="M0,3H2V5H24V17H18V20H7V17H2V21H0Z M8,8A3,3 0 1,0 8,14A3,3 0 1,0 8,8Z M17,8A3,3 0 1,0 17,14A3,3 0 1,0 17,8Z"/>
          </ToggleButton>
          <ToggleButton x:Name="AudioExportButton" Classes="normal dockButton" Background="Transparent"
                        Width="35" Height="44" Margin="2,8" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsChecked="{Binding IsAudioExportPanelOpen, Mode=OneWay}" Click="OnToggleAudioExportPanel" ToolTip.Tip="导出音频">
            <Path Data="M10 2H22V14L18 10L12 16L8 12L14 6Z M7 13L11 17L7 21L3 17Z M2 21H22V24H2Z"/>
          </ToggleButton>
          <ToggleButton x:Name="PreferencesButton" Classes="normal dockButton" Background="Transparent"
                        Width="35" Height="44" Margin="2,8" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsChecked="{Binding IsPreferencesPanelOpen, Mode=OneWay}"
                        Click="OnTogglePreferencesPanel"
                        ToolTip.Tip="{DynamicResource menu.tools.prefs}">
            <Path Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.47,2.18 14.26,2 14,2H10C9.74,2 9.53,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.72,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.53,21.82 9.74,22 10,22H14C14.26,22 14.47,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.28,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z M12,8.5A3.5,3.5 0 1,1 12,15.5A3.5,3.5 0 1,1 12,8.5Z"/>
          </ToggleButton>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
